# ---------------------------------------------------------------------------
# Sipium Flash — environment configuration
# Copy to .env (local) or set these in Vercel / Replit project settings.
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Backend -----------------------------------------------------------------
# Where the Replit-hosted API lives. In production this is your Replit URL,
# e.g. https://sipium-flash-api.<user>.repl.co
# Leave unset for local development: the bundled server on port 8787 is used.
# REPLIT_API_URL=https://sipium-flash-api.example.repl.co

# Shared secret sent as x-sipium-internal-key from Next.js -> Replit backend.
# Optional but recommended in production.
# REPLIT_API_KEY=

# Port for the bundled API server (local dev / Replit).
API_PORT=8787

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. Required in production (Replit provides this).
# If unset, the API falls back to an embedded PostgreSQL (PGlite) file-backed
# database under ./.pgdata so local development works with zero setup.
# DATABASE_URL=postgresql://user:password@host:5432/sipium

# --- AI providers ------------------------------------------------------------
# Architecture: Browser -> Next.js -> Replit API -> xKiro -> MiniMax M3
# Both keys stay server-side. They are never sent to the browser.

# xKiro (OpenAI-compatible gateway). Primary provider when set.
# XKIRO_API_KEY=
# XKIRO_BASE_URL=https://api.xkiro.com/v1
# XKIRO_MODEL=minimax-m3

# MiniMax M3 (direct). Used when xKiro is not configured.
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=MiniMax-M3

# Which provider to prefer: auto | xkiro | minimax  (default: auto)
AI_PROVIDER=auto

# Model used for image understanding (vision). Falls back to XKIRO_MODEL.
# AI_VISION_MODEL=

# If no provider key is present the API runs a deterministic OFFLINE engine.
# It is reported as `configured: false` by /api/health and labelled in the UI.
# Set to "false" to hard-fail instead of falling back.
AI_ALLOW_OFFLINE_FALLBACK=true

# --- Limits ------------------------------------------------------------------
AI_RATE_LIMIT_PER_MIN=12
PUBLISH_RATE_LIMIT_PER_MIN=6
MAX_IMAGE_BYTES=8000000
MAX_BODY_BYTES=2000000
